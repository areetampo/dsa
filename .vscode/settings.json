{
  /* --- Editor & UI --- */
  "window.zoomLevel": -0.4,
  "window.commandCenter": false,
  "workbench.colorTheme": "Gruvbox Dark Hard",
  "workbench.editor.enablePreview": false,
  "workbench.activityBar.location": "top",
  "workbench.tree.indent": 8,
  "workbench.tree.renderIndentGuides": "onHover",
  "workbench.panel.showLabels": false,
  "workbench.layoutControl.enabled": false,
  "explorer.openEditors.visible": 1,
  "explorer.compactFolders": true,
  "explorer.confirmDragAndDrop": false,
  "explorer.autoReveal": "focusNoScroll",
  "explorer.fileNesting.enabled": false,
  "explorer.fileNesting.expand": true,
  "explorer.fileNesting.patterns": {},
  "workbench.colorCustomizations": {
    "editor.selectionBackground": "#5f6b5fc4",
    "editor.selectionHighlightBackground": "#6f7d6fb0",
    "editor.wordHighlightBackground": "#4a5f5ac0",
    "editor.wordHighlightBorder": "#4a5266",
    "list.activeSelectionBackground": "#313131",
    "list.activeSelectionBorder": "#ffffffff",
    "list.inactiveSelectionBackground": "#3b3b3bcc",
    "list.hoverBackground": "#ffffff22",
    "gitDecoration.ignoredResourceForeground": "#787878",
    "gitDecoration.conflictingResourceForeground": "#ffcc00",
    "gitDecoration.modifiedResourceForeground": "#dcad48",
    "gitDecoration.deletedResourceForeground": "#ff5555",
    "sideBar.border": "#3d3d3d99",
    "tree.indentGuidesStroke": "#ffffff88",
    "list.activeSelectionForeground": "#ffffff",
    "pickerGroup.border": "#00ff88",
    "widget.border": "#444444",
    "editorOverviewRuler.border": "#ffffff00",
    "scrollbarSlider.background": "#ffffff11",
    "scrollbarSlider.hoverBackground": "#ffffff22",
    "scrollbarSlider.activeBackground": "#ffffff33",
    "minimap.background": "#0d1117",
    "minimapSlider.background": "#ffffff25",
    "minimapSlider.hoverBackground": "#ffffff35",
    "minimapSlider.activeBackground": "#ffffff45",
    "terminal.inactiveSelectionBackground": "#ffffff08",
    "terminal.tab.activeBorder": "#88b898",
    "terminal.tab.activeBackground": "#ffffff15",
    "terminalCursor.foreground": "#ffffff",
    "terminalCursor.background": "#000000",
    "terminal.selectionBackground": "#ffffff22",
    "terminal.border": "#3d3d3d99",
    "panel.border": "#3d3d3d99"
  },
  "editor.hover.delay": 300,
  "editor.hover.sticky": true,
  "editor.scrollbar.verticalScrollbarSize": 30,
  "editor.scrollbar.horizontalScrollbarSize": 30,
  "editor.scrollbar.vertical": "visible",
  "editor.scrollbar.horizontal": "visible",
  "explorer.confirmDelete": false,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 95,
  "editor.minimap.enabled": false,
  "editor.minimap.size": "proportional",
  "editor.minimap.showSlider": "always",
  "editor.minimap.maxColumn": 70,
  "editor.minimap.scale": 2,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.autohide": "mouseover",
  "editor.minimap.side": "right",
  "editor.linkedEditing": true,
  "editor.fontFamily": "JetBrains Mono NL",
  "editor.fontWeight": "500",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": true,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "expand",
  "editor.guides.bracketPairs": "active",
  "editor.lineNumbers": "on",
  "editor.renderLineHighlight": "all",
  "editor.tabSize": 2,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "breadcrumbs.enabled": false,

  /* --- Prettier Style Rules (Applied Globally) --- */
  "prettier.printWidth": 100,
  "prettier.tabWidth": 2,
  "prettier.useTabs": false,
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": false,
  "prettier.trailingComma": "all",
  "prettier.bracketSpacing": true,
  "prettier.bracketSameLine": false,
  "prettier.arrowParens": "always",
  "prettier.endOfLine": "lf",

  /* --- Formatting & Linting --- */
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "prettier.requireConfig": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.enable": true,
  "eslint.run": "onType",
  "eslint.rules.customizations": [
    { "rule": "import/order", "severity": "off" },
    { "rule": "unused-imports/no-unused-imports", "severity": "off" }
  ],

  /* --- Language-Specific Formatter Mapping --- */
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },

  /* --- C++ Intelligence & Runner Settings --- */
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp_Runner.cCompilerPath": "gcc",
  "C_Cpp_Runner.cppCompilerPath": "g++",
  "C_Cpp_Runner.debuggerPath": "gdb",
  "C_Cpp_Runner.useMsvc": false,
  "C_Cpp_Runner.warnings": [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wshadow",
    "-Wformat=2",
    "-Wcast-align",
    "-Wconversion",
    "-Wsign-conversion",
    "-Wnull-dereference"
  ],
  "C_Cpp_Runner.msvcBatchPath": "C:/Program Files/Microsoft Visual Studio/VR_NR/Community/VC/Auxiliary/Build/vcvarsall.bat",
  "C_Cpp_Runner.enableWarnings": true,
  "C_Cpp_Runner.includeSearch": ["*", "**/*"],
  "C_Cpp_Runner.excludeSearch": [
    "**/build",
    "**/build/**",
    "**/.*",
    "**/.*/**",
    "**/.vscode",
    "**/.vscode/**"
  ],
  "C_Cpp_errorSquiggles.enable": false,
  "C_Cpp_Runner.cStandard": "",
  "C_Cpp_Runner.cppStandard": "",
  "C_Cpp_Runner.msvcWarnings": [
    "/W4",
    "/permissive-",
    "/w14242",
    "/w14287",
    "/w14296",
    "/w14311",
    "/w14826",
    "/w44062",
    "/w44242",
    "/w14905",
    "/w14906",
    "/w14263",
    "/w44265",
    "/w14928"
  ],
  "C_Cpp_Runner.warningsAsError": false,
  "C_Cpp_Runner.compilerArgs": [],
  "C_Cpp_Runner.linkerArgs": [],
  "C_Cpp_Runner.includePaths": [],
  "C_Cpp_Runner.useAddressSanitizer": false,
  "C_Cpp_Runner.useUndefinedSanitizer": false,
  "C_Cpp_Runner.useLeakSanitizer": false,
  "C_Cpp_Runner.showCompilationTime": false,
  "C_Cpp_Runner.useLinkTimeOptimization": false,
  "C_Cpp_Runner.msvcSecureNoWarnings": false,
  "files.associations": {
    "*.tcc": "cpp",
    "iostream": "cpp",
    "chrono": "cpp",
    "random": "cpp",
    "limits": "cpp",
    "valarray": "cpp",
    "array": "cpp",
    "bitset": "cpp",
    "initializer_list": "cpp",
    "regex": "cpp",
    "utility": "cpp",
    "ostream": "cpp",
    "cmath": "cpp",
    "complex": "cpp",
    "cstdlib": "cpp",
    "atomic": "cpp",
    "cctype": "cpp",
    "cfenv": "cpp",
    "cinttypes": "cpp",
    "clocale": "cpp",
    "codecvt": "cpp",
    "condition_variable": "cpp",
    "csetjmp": "cpp",
    "csignal": "cpp",
    "cstdarg": "cpp",
    "cstddef": "cpp",
    "cstdint": "cpp",
    "cstdio": "cpp",
    "cstring": "cpp",
    "ctime": "cpp",
    "cuchar": "cpp",
    "cwchar": "cpp",
    "cwctype": "cpp",
    "deque": "cpp",
    "forward_list": "cpp",
    "list": "cpp",
    "unordered_map": "cpp",
    "unordered_set": "cpp",
    "vector": "cpp",
    "exception": "cpp",
    "algorithm": "cpp",
    "functional": "cpp",
    "iterator": "cpp",
    "map": "cpp",
    "memory": "cpp",
    "memory_resource": "cpp",
    "numeric": "cpp",
    "ratio": "cpp",
    "set": "cpp",
    "string": "cpp",
    "system_error": "cpp",
    "tuple": "cpp",
    "type_traits": "cpp",
    "fstream": "cpp",
    "future": "cpp",
    "iomanip": "cpp",
    "iosfwd": "cpp",
    "istream": "cpp",
    "mutex": "cpp",
    "new": "cpp",
    "scoped_allocator": "cpp",
    "shared_mutex": "cpp",
    "sstream": "cpp",
    "stdexcept": "cpp",
    "streambuf": "cpp",
    "thread": "cpp",
    "typeindex": "cpp",
    "typeinfo": "cpp"
    // (Note: VS Code handles most of these automatically now, but keeping them keeps your logic identical)
  },

  /* --- Global Exclusions --- */
  "files.exclude": {},
  "search.exclude": {
    "**/build": true,
    "**/*.exe": true,
    "**/*.o": true
  },
  "files.watcherExclude": {},

  "python.defaultInterpreterPath": "python",
  "java.configuration.updateBuildConfiguration": "interactive",
  "cph.general.saveLocation": "",

  /* --- Global Performance & Telemetry --- */
  "telemetry.telemetryLevel": "off",
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none",
  "scm.countBadge": "off",
  "gitlens.currentLine.enabled": false,
  "gitlens.codeLens.enabled": false,
  "files.autoSave": "afterDelay",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  /* --- The "Unused" Silence Logic --- */
  "editor.showUnused": true,

  /* --- Terminal --- */
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontFamily": "SF Mono",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontWeight": 900,
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorStyleInactive": "underline",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.suggest.runOnEnter": "never",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.confirmOnKill": "always",

  /* --- File & System Management --- */
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "~/AppData/Local/Temp/postman-collections-post-response.instructions.md": true,
    "~/AppData/Local/Temp/postman-collections-pre-request.instructions.md": true,
    "~/AppData/Local/Temp/postman-folder-post-response.instructions.md": true,
    "~/AppData/Local/Temp/postman-folder-pre-request.instructions.md": true,
    "~/AppData/Local/Temp/postman-http-request-post-response.instructions.md": true,
    "~/AppData/Local/Temp/postman-http-request-pre-request.instructions.md": true,
    "C:\\Users\\Areeb\\AppData\\Local\\Temp\\postman-collections-post-response.instructions.md": true,
    "C:\\Users\\Areeb\\AppData\\Local\\Temp\\postman-collections-pre-request.instructions.md": true,
    "C:\\Users\\Areeb\\AppData\\Local\\Temp\\postman-folder-post-response.instructions.md": true,
    "C:\\Users\\Areeb\\AppData\\Local\\Temp\\postman-folder-pre-request.instructions.md": true,
    "C:\\Users\\Areeb\\AppData\\Local\\Temp\\postman-http-request-post-response.instructions.md": true,
    "C:\\Users\\Areeb\\AppData\\Local\\Temp\\postman-http-request-pre-request.instructions.md": true
  },
  "console-ninja.featureSet": "Community",
  "claudeCode.preferredLocation": "panel",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "path": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": ["-NoExit", "-Command", "& { . $PROFILE }"]
    },
    "Command Prompt": {
      "path": "C:\\WINDOWS\\System32\\cmd.exe",
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-git-bash"
    }
  },
  "chat.viewSessions.orientation": "stacked",

  /* --- no autocomplete --- */
  "editor.quickSuggestions": {
    "other": "off",
    "comments": "off",
    "strings": "off"
  },
  "editor.inlineSuggest.enabled": false,
  "editor.suggestOnTriggerCharacters": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.parameterHints.enabled": false,
  "editor.wordBasedSuggestions": "off",
  "editor.suggest.showWords": false,
  "editor.suggest.showSnippets": false,
  "editor.suggest.showClasses": false,
  "editor.suggest.showFunctions": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.secondarySideBar.defaultVisibility": "hidden"
}
